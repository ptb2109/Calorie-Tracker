# Copy this file to .env (which git ignores) and change values there.

# Port the server listens on inside its container
PORT=4000

# MongoDB connection string. "mongo" is the database container's name in docker-compose.yml;
# "calorie_tracker" is the database name (MongoDB creates it on first write).
MONGO_URI=mongodb://mongo:27017/calorie_tracker

# Secret used to sign login tokens: a long random string (at least 32 characters).
# Generate one with:
#   docker compose exec server node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a login lasts, e.g. 7d (days), 12h (hours)
JWT_EXPIRES_IN=7d

# USDA FoodData Central key for food search (free: https://fdc.nal.usda.gov/api-key-signup).
# Optional: without it, the shared DEMO_KEY is used (30 searches per hour).
USDA_API_KEY=